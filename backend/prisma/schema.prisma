generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  USUARIO
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  nombres        String
  apellidos      String
  dni            String    @unique
  rol            Rol       @default(USUARIO)
  empresaId      String?
  empresa        Empresa?  @relation(fields: [empresaId], references: [id])
  areaId         String?
  area           Area?     @relation("Miembros", fields: [areaId], references: [id])
  proyDef        String    @default("")
  proyectos      String[]
  emailTo        String[]
  emailCc        String[]
  bank           String    @default("BCP")
  accountNumber  String    @default("")
  currency       String    @default("SOLES")
  activo         Boolean   @default(true)
  signaturePath  String?
  consentPdfPath String?
  consentAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  refreshTokens RefreshToken[]
  planillas     Planilla[]
  areasACargo   Area[]         @relation("Aprobador")
  comprobantes  Comprobante[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Empresa {
  id        String  @id @default(uuid())
  razon     String
  ruc       String  @default("")
  direccion String  @default("")
  logoPath  String?
  users     User[]

  @@map("empresas")
}

model Area {
  id              String   @id
  nombre          String
  approverId      String?
  approver        User?    @relation("Aprobador", fields: [approverId], references: [id])
  allowedPrefixes String[]
  allowedIds      String[]
  miembros        User[]   @relation("Miembros")

  @@map("areas")
}

model PartidaContable {
  codigo      String @id
  descripcion String @default("")

  @@map("partidas_contables")
}

model MovilidadPartida {
  codigo String @id

  @@map("movilidad_partidas")
}

model Counter {
  dni   String @id
  count Int    @default(0)

  @@map("counters")
}

model Planilla {
  id            String   @id @default(uuid())
  serie         String
  numero        String
  fechaEmision  DateTime @db.Date
  fechaRegistro DateTime @default(now())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  userDni       String
  userNombre    String
  areaId        String   @default("")
  areaNombre    String   @default("")
  vbOk          Boolean  @default(false)
  vbById        String?
  vbByName      String?
  vbAt          DateTime?
  pagado        Boolean  @default(false)
  pagadoById    String?
  pagadoByName  String?
  pagadoAt      DateTime?
  pdfPath       String
  lineas        PlanillaLinea[]
  comprobantes  Comprobante[]

  @@unique([userDni, serie, numero])
  @@index([userId])
  @@index([areaId])
  @@index([fechaEmision])
  @@map("planillas")
}

model PlanillaLinea {
  id         String   @id @default(uuid())
  planillaId String
  planilla   Planilla @relation(fields: [planillaId], references: [id], onDelete: Cascade)
  orden      Int
  destino    String
  motivo     String
  proyecto   String
  pc         String
  monto      Decimal  @db.Decimal(12, 2)

  @@index([planillaId])
  @@map("planilla_lineas")
}

model Comprobante {
  id             String   @id @default(uuid())
  planillaId     String
  planilla       Planilla @relation(fields: [planillaId], references: [id], onDelete: Cascade)
  originalName   String
  storagePath    String
  uploadedById   String
  uploadedBy     User     @relation(fields: [uploadedById], references: [id])
  uploadedByName String
  uploadedAt     DateTime @default(now())

  @@index([planillaId])
  @@map("comprobantes")
}
