rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuario autenticado Y activo (campo activo != false; si falta, se considera activo)
    function isActive() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('activo', true) != false;
    }

    function isSignedIn() {
      return request.auth != null && isActive();
    }

    function userData() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isAdmin() {
      return isSignedIn() && userData().rol == 'ADMIN';
    }

    // No exige estar activo: así un usuario desactivado puede leer su perfil y ver el aviso
    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isApproverForArea(areaId) {
      return isSignedIn()
        && areaId != null
        && exists(/databases/$(database)/documents/areas/$(areaId))
        && get(/databases/$(database)/documents/areas/$(areaId)).data.approverUid == request.auth.uid;
    }

    function onlyVbFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['vbOk','vbByUid','vbByName','vbAt']);
    }

    function comprobantesWriteOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['comprobantes'])
        || request.resource.data.pagado == true
        || (request.resource.data.comprobantes is list && request.resource.data.comprobantes.size() == 0);
    }

    // ═══════════════════════════════════
    //  COMPARTIDAS (Planilla + Caja Chica + Movilidad)
    // ═══════════════════════════════════

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isSelf(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol','areaId','activo','cajaChicaActivo']));
      allow delete: if isAdmin();
    }

    match /empresas/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /partidasContables/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /proyectos/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /areas/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════
    //  PLANILLA WEB
    // ═══════════════════════════════════

    match /history/{id} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
        || isApproverForArea(resource.data.areaId)
      );
      allow create: if isSignedIn() && (
        isAdmin() || request.resource.data.userId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        (isAdmin() && comprobantesWriteOk())
        || (isApproverForArea(resource.data.areaId) && onlyVbFieldsChanged())
      );
      allow delete: if isAdmin();
    }

    // Configuración general (p. ej. partidas de movilidades). Lectura: activos; escritura: solo ADMIN
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /counters/{dni} {
      allow read, write: if isSignedIn();
    }

    // ═══════════════════════════════════
    //  CAJA CHICA WEB
    // ═══════════════════════════════════

    // Acceso a Caja Chica: habilitado por el administrador (cajaChicaActivo == true) o ADMIN
    function puedeCajaChica() {
      return isAdmin() || (isSignedIn() && userData().get('cajaChicaActivo', false) == true);
    }

    // Cajas activas (1 por usuario)
    match /cajasChicasActivas/{userId} {
      allow read: if puedeCajaChica() && (isSelf(userId) || isAdmin());
      allow write: if puedeCajaChica() && (isSelf(userId) || isAdmin());

      match /expenses/{expenseId} {
        allow read: if puedeCajaChica() && (isSelf(userId) || isAdmin());
        allow write: if puedeCajaChica() && (isSelf(userId) || isAdmin());
      }
    }

    // Historial de cajas cerradas
    match /cajasChicasHistorial/{docId} {
      allow read: if puedeCajaChica();
      allow write: if puedeCajaChica();

      match /expenses/{expenseId} {
        allow read: if puedeCajaChica();
        allow write: if puedeCajaChica();
      }
    }

    // Contadores por proyecto (numeración independiente por obra)
    match /cajasChicasContadores/{obraId} {
      allow read, write: if puedeCajaChica();
    }
  }
}
