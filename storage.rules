rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Usuario autenticado Y activo (campo activo != false en users/{uid}; si falta, se considera activo)
    function estaActivo() {
      return request.auth != null &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.get('activo', true) != false;
    }
    function esAdmin() {
      return estaActivo() &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.rol == 'ADMIN';
    }
    // Consentimientos (Planilla)
    match /consentimientos/{uid}/{filename} {
      allow read: if estaActivo() && (request.auth.uid == uid || esAdmin());
      allow write: if estaActivo() && request.auth.uid == uid;
    }
    // Planillas PDF
    match /planillas/{uid}/{filename} {
      allow read: if estaActivo() && (request.auth.uid == uid || esAdmin());
      allow write: if estaActivo() && (request.auth.uid == uid || esAdmin());
    }
    // Comprobantes de pago (Planilla)
    match /comprobantes/{uid}/{planillaKey}/{filename} {
      allow read: if estaActivo() && (request.auth.uid == uid || esAdmin());
      allow write: if estaActivo() && esAdmin();
    }
    // Acceso a Caja Chica: cajaChicaActivo == true o ADMIN
    function puedeCajaChica() {
      return esAdmin() || (estaActivo() &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.get('cajaChicaActivo', false) == true);
    }
    // Comprobantes de Caja Chica (PDF, Imágenes)
    match /caja_chica_comprobantes/{userId}/{allPaths=**} {
      allow read: if puedeCajaChica();
      allow write: if puedeCajaChica() && (request.auth.uid == userId || esAdmin());
    }
    // Logos de empresa
    match /logos/{allPaths=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && esAdmin();
    }
    // ----------------------------------------------------
    // NUEVO: Firmas de Caja Chica (Añadido para solucionar error)
    // ----------------------------------------------------
    match /caja_chica_firmas/{fileName} {
      allow read: if puedeCajaChica();
      allow write: if puedeCajaChica();
    }
  }
}
